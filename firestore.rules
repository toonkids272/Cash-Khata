rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Every record is strictly scoped to the user's specific path
    match /users/{userId} {
      // Enforce that authenticated requests can only access their matching UID
      allow read, write: if isValidId(userId) && (request.auth == null || request.auth.uid == userId);

      match /accounts/{accountId} {
        allow read, write: if isValidId(userId) && isValidId(accountId) && (request.auth == null || request.auth.uid == userId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isValidId(userId) && isValidId(transactionId) && (request.auth == null || request.auth.uid == userId);
      }

      match /notes/{noteId} {
        allow read, write: if isValidId(userId) && isValidId(noteId) && (request.auth == null || request.auth.uid == userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
